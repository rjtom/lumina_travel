#!/bin/bash
# Script to stop the Lumina Travel Concierge backend server

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_DIR"

echo "=== Stopping Lumina Travel Concierge Infrastructure ==="

# Stop FastAPI server on port 8002
PID_8002=$(lsof -t -i :8002 2>/dev/null)
if [ -n "$PID_8002" ]; then
  echo "🛑 Stopping FastAPI Server (PID: $PID_8002)..."
  kill $PID_8002
  sleep 1
  # Force kill if still alive
  if kill -0 $PID_8002 2>/dev/null; then
    echo "⚠️ Force-killing FastAPI Server..."
    kill -9 $PID_8002
  fi
  echo "✅ Lumina Travel Concierge server stopped."
else
  echo "ℹ️ Lumina Travel Concierge server is not running on port 8002."
fi

echo "=== Infrastructure Cleaned ==="
lsof -i :8002 2>/dev/null || echo "🎉 Service stopped successfully."
echo "=================================================="
